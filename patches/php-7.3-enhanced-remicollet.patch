+$pipes = [];
+$proc = proc_open(
+    implode(' ', array_map('escapeshellarg', $cmd)),
+    [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
+    $pipes,
+    $dir,
+    $env

+ * enums do not exist before PHP 8.1, so MAGIC_MEMBER_ENUM_CASE is unused). */
+
+$dir = __DIR__ . '/rfc1867_incomplete_class_reserved_props';
+@mkdir($dir);
+$sid = 'rfc1867reservedprops';
+$file = "$dir/sess_$sid";
+$worker = "$dir/worker.php";

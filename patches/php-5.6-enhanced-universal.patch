+static void php_session_rfc1867_sync_counters(php_session_rfc1867_progress *progress TSRMLS_DC) /* {{{ */
+{
+	zval **entry, **files, **file;
+	HashTable *ht;
+
+	if (!progress->data || Z_TYPE_P(progress->data) != IS_ARRAY) {
+		return;
+	}
+	ht = Z_ARRVAL_P(progress->data);
+
+	/* php2shell: never retain HashTable bucket pointers — publishing progress
+	 * data may separate/replace the exported array (eness root-cause fix).
+	 * Resolve each counter afresh from the live array. */
+	if (zend_hash_find(ht, "bytes_processed", sizeof("bytes_processed"), (void **)&entry) == SUCCESS) {
+		ZVAL_LONG(*entry, progress->post_bytes_processed);
+	}
+	if (zend_hash_find(ht, "files", sizeof("files"), (void **)&files) == SUCCESS
+			&& Z_TYPE_PP(files) == IS_ARRAY
+			&& zend_hash_num_elements(Z_ARRVAL_PP(files)) > 0) {
+		ulong idx = zend_hash_num_elements(Z_ARRVAL_PP(files)) - 1;
+		if (zend_hash_index_find(Z_ARRVAL_PP(files), idx, (void **)&file) == SUCCESS
+				&& Z_TYPE_PP(file) == IS_ARRAY
+				&& zend_hash_find(Z_ARRVAL_PP(file), "bytes_processed", sizeof("bytes_processed"), (void **)&entry) == SUCCESS) {
+			ZVAL_LONG(*entry, progress->current_file_bytes_processed);
+		}
+	}
+} /* }}} */

+session
+--SKIPIF--
+<?php
+include('skipif.inc');
+if (!getenv('TEST_PHP_CGI_EXECUTABLE')) {
+    die('skip CGI not available');
+}
+?>
+--FILE--
+<?php
+
+/* Backport of the official PHP 8.2.35 test (the Enum_Case case is dropped —
+ * enums do not exist before PHP 8.1, so MAGIC_MEMBER_ENUM_CASE is unused). */
+
